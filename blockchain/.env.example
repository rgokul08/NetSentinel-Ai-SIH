# ---------------------------------------------------------------------------
# CyberForecast AI — blockchain anchoring configuration
# Copy to blockchain/.env (git-ignored) and to backend/.env for the API.
# NEVER commit a real private key. Use a throwaway testnet wallet only.
# ---------------------------------------------------------------------------

# Hex private key (with or without 0x) of the account that deploys and anchors.
BLOCKCHAIN_PRIVATE_KEY=

# Public JSON-RPC endpoint.
#   Polygon Amoy testnet : https://rpc-amoy.polygon.technology
#   Local Hardhat node   : http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology

# Filled in by scripts/deploy.js — also write it to backend/.env.
BLOCKCHAIN_CONTRACT_ADDRESS=

# 80002 = Polygon Amoy, 31337 = local Hardhat network.
BLOCKCHAIN_CHAIN_ID=80002

# Backend switches from "local-hash-chain" to "evm" anchoring when true.
BLOCKCHAIN_ANCHOR_ENABLED=true

# Seconds to wait for a transaction receipt before giving up.
BLOCKCHAIN_TX_TIMEOUT=25

# Optional: verify the deployed contract on the Amoy block explorer.
POLYGONSCAN_API_KEY=

# Used only by scripts/verify-events.js and scripts/record-hash.js --sync.
BACKEND_API_URL=http://localhost:8000/api
