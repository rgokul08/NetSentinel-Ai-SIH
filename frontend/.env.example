# ===========================================================================
# CyberForecast AI — frontend configuration
# Copy to frontend/.env.local (Vite only exposes VITE_* variables to the browser).
# The app works with no .env file at all: it calls same-origin /api, which the
# Vite dev server proxies to the backend and nginx proxies in Docker.
# ===========================================================================

# Base URL of the FastAPI API.
#   Development (Vite proxy)   : leave empty -> "/api" is proxied to :8000
#   Docker (nginx proxy)       : leave empty -> "/api" is proxied to the backend service
#   Separate deployments       : https://your-backend.onrender.com/api
VITE_API_URL=

# Optional: override the WebSocket URL used for the live traffic feed.
# Defaults to the API host with the /api/traffic/ws path, upgrading ws->wss on https.
VITE_WS_URL=
