# ===========================================================================
# CyberForecast AI — backend configuration
# Copy to backend/.env and adjust. NEVER commit the filled-in file.
# Every value below has a working default, so the platform boots with an empty
# .env (SQLite store, local hash-chain ledger, demo accounts seeded).
# ===========================================================================

# --- Application -----------------------------------------------------------
APP_NAME=CyberForecast AI
# Subtitle shown in the API schema and reports
APP_SUBTITLE=AI-Based Network Attack Forecasting & Blockchain-Assured Cybersecurity
APP_VERSION=2.0.0
# development | demo | test | production
# In non-production environments a password-reset token is returned by the API
# (no mail provider is wired up); in production it is only logged as an event.
APP_ENV=development
DEBUG=true

# --- Security --------------------------------------------------------------
# REQUIRED in production: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# Legacy alias for JWT_SECRET_KEY (JWT_SECRET_KEY wins when both are set)
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Development shortcut: allow any origin. Must stay false in production.
CORS_ALLOW_ALL=true

# Rate limits (slowapi syntax)
RATE_LIMIT=300/minute
AUTH_RATE_LIMIT=20/minute

# --- Database --------------------------------------------------------------
# Default: SQLite file under backend/data/ (auto-created, auto-migrated).
# PostgreSQL (docker-compose / Render):
#   DATABASE_URL=postgresql://user:password@host:5432/cyberforecast
DATABASE_URL=

# --- Appwrite (optional cloud backend) -------------------------------------
# When all three of ENDPOINT / PROJECT_ID / API_KEY are set, Appwrite becomes the
# primary store for auth, database and file storage; the SQL store stays as an
# automatic fallback if Appwrite is unreachable.
APPWRITE_ENABLED=true
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=cyberforecast
APPWRITE_BUCKET_ID=cyberforecast-datasets

# --- ML pipeline -----------------------------------------------------------
# random_forest | gradient_boosting | logistic_regression | extra_trees | isolation_forest
DEFAULT_CLASSIFIER=random_forest
# Expected anomaly fraction for the Isolation Forest detector (0.005 – 0.4)
ANOMALY_CONTAMINATION=0.1
# Rows scored per batch request
PREDICTION_SAMPLE_LIMIT=5000
# Where trained .joblib artifacts are stored (defaults to backend/models/)
MODEL_PATH=
# Retrain automatically when the process boots without an active model
AUTO_TRAIN_ON_STARTUP=false

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_UPLOAD_ROWS=500000
ALLOWED_UPLOAD_EXTENSIONS=.csv,.json

# --- Alerting --------------------------------------------------------------
# The alert throttle window (repeat alerts for the same source/target pair are
# suppressed) is a runtime setting, not an environment variable: change it in
# Admin Console -> Runtime configuration (default 5 minutes, audited).

# --- Demo data / seeding ---------------------------------------------------
SEED_DEMO_DATA=true
SEED_TRAFFIC_RECORDS=1800
# Path to the labelled CSV used to train the seeded models
SEED_DATASET=

# Demo accounts created by the seeder. CHANGE THESE IN PRODUCTION.
DEMO_ADMIN_EMAIL=admin@cyberforecast.ai
DEMO_ADMIN_PASSWORD=Admin@1234
DEMO_ANALYST_EMAIL=analyst@cyberforecast.ai
DEMO_ANALYST_PASSWORD=Analyst@1234
DEMO_VIEWER_EMAIL=viewer@cyberforecast.ai
DEMO_VIEWER_PASSWORD=Viewer@1234

# --- Simulation ------------------------------------------------------------
SIMULATION_AUTOSTART=false
# Flows generated per tick multiplier (1 – 10)
SIMULATION_DEFAULT_RATE=5

# --- Blockchain integrity anchoring ----------------------------------------
# Without these the platform uses its local SHA-256 hash chain, which already
# detects tampering. Adding them anchors event hashes on an EVM chain as well.
# See blockchain/README.md for deployment and verification steps.
BLOCKCHAIN_ANCHOR_ENABLED=false
# Local node: http://127.0.0.1:8545 · Polygon Amoy: https://rpc-amoy.polygon.technology
BLOCKCHAIN_RPC_URL=
# 31337 = local Hardhat/Ganache · 80002 = Polygon Amoy
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
# Private key of an address whitelisted as a recorder on the contract.
# Use a throwaway testnet key only — never a wallet holding real funds.
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_TX_TIMEOUT=25
